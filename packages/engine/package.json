{
  "name": "@lacuna/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "default": "./dist/env.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "probe": "tsx src/scripts/probe.ts",
    "kite-probe": "tsx src/scripts/kite-probe.ts",
    "compile": "tsx src/scripts/compile-policy.ts",
    "attack": "tsx src/scripts/attack.ts",
    "run-audit": "tsx src/scripts/run.ts",
    "lacuna": "tsx src/scripts/audit.ts",
    "lacuna-showcase": "tsx src/scripts/export-showcase.ts",
    "persuade-probe": "tsx src/scripts/persuade-probe.ts",
    "audit-agent": "tsx src/scripts/audit-agent.ts"
  },
  "dependencies": {
    "@lacuna/core": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "openai": "7.20.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.5.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
