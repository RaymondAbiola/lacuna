{
  "name": "@lacuna/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node scripts/check-rounds.mjs && pnpm --filter @lacuna/core build && pnpm --filter @lacuna/engine build && next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "check-rounds": "node scripts/check-rounds.mjs"
  },
  "dependencies": {
    "@lacuna/core": "workspace:*",
    "@lacuna/engine": "workspace:*",
    "next": "16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
